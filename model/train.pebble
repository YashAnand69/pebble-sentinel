import { Transformer, config } from "./transformer.pebble";
import { makeBatch, evaluateLoss } from "./dataset.pebble";
const seed = num(io.arg("--seed","2026"));
const steps = num(io.arg("--steps","500"));
const size = num(io.arg("--batch","2"));
const length = 256;
assert(steps >= 1 && steps == floor(steps) && size >= 1 && size <= 8 && size == floor(size),"Invalid training configuration");
ml.seed(seed);
const model = Transformer();
let train = [];
for shard in range(8) { train += parseJSON(io.readText("data/train-"+str(shard)+".json")); }
const validation = parseJSON(io.readText("data/validation.json"));
const optimizer = ml.adamW(model.parameters,0.01,0.9,0.95);
const baseline = evaluateLoss(model,validation);
let best = baseline; let bestStep = 0; let history = [];
const started = io.now();
print("Sentinel PAL transformer",model.count(),"parameters seed",seed,"baseline",baseline);
for step in range(1,steps+1) {
 const rate = 0.0015 * min(1,step/25) * (0.1 + 0.9*(1+cos(PI*step/steps))/2);
 const loss = ml.scope(fn() {
  const batch = makeBatch(train,size,length);
  return ml.minimize(optimizer,fn()=>model.loss(batch.ids,batch.targets),rate,1);
 });
 if (step == 1 || step % 50 == 0 || step == steps) {
  const validationLoss = evaluateLoss(model,validation);
  if (validationLoss < best) {
   best=validationLoss;bestStep=step;
   io.saveWeights("weights/seed-"+str(seed)+".pebble-weights",model.parameters,{config,seed,step,validationLoss,license:"MIT",corpus:"benign PAL workflow templates"});
  }
  const record={step,trainLoss:loss,validationLoss,rate,elapsedSeconds:(io.now()-started)/1000};
  history.push(record);
  io.writeText("reports/seed-"+str(seed)+"-history.json",stringifyJSON(history));
  print("Step",step,"train",loss,"validation",validationLoss,"seconds",record.elapsedSeconds);
 }
}
io.writeText("reports/seed-"+str(seed)+".json",stringifyJSON({parameters:model.count(),config,seed,steps,batch:size,length,baseline,bestValidationLoss:best,bestStep,elapsedSeconds:(io.now()-started)/1000,backend:ml.backend()}));
